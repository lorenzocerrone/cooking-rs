  "ingredients": [
    { "ingredient": "egg_noodles", "amount": 200 },
    { "ingredient": "peanut_butter", "amount": 40 },
    { "ingredient": "soy_sauce", "amount": 2, "unit": "tbsp" },
    { "ingredient": "sesame_oil", "amount": 1, "unit": "tbsp" },
    { "ingredient": "honey", "amount": 15 },
    { "ingredient": "lime", "amount": 1, "note": "juiced" },
    { "ingredient": "garlic", "amount": 1, "unit": "clove", "note": "crushed" },
    { "ingredient": "cucumber", "amount": 0.5, "unit": "pcs", "note": "in matchsticks" },
    { "ingredient": "scallion", "amount": 2, "unit": "pcs", "note": "sliced" },
    { "ingredient": "tofu", "amount": 200, "note": "cubed and fried", "optional": true },
    { "ingredient": "chili_flakes", "optional": true }
