  "ingredients": [
    { "name": "Egg noodles", "amount": 200, "unit": "g" },
    { "name": "Peanut butter", "amount": 40, "unit": "g" },
    { "name": "Soy sauce", "amount": 2, "unit": "tbsp" },
    { "name": "Sesame oil", "amount": 1, "unit": "tbsp" },
    { "name": "Honey", "amount": 15, "unit": "g" },
    { "name": "Lime", "amount": 1, "note": "juiced" },
    { "name": "Garlic", "amount": 1, "unit": "clove", "note": "crushed" },
    { "name": "Cucumber", "amount": 0.5, "unit": "pcs", "note": "in matchsticks" },
    { "name": "Scallion", "amount": 2, "unit": "pcs", "note": "sliced" },
    { "name": "Tofu", "amount": 200, "unit": "g", "note": "cubed and fried", "optional": true },
    { "name": "Chili flakes", "optional": true }
  ],
  "steps": [
    "Cook the noodles, then rinse them under cold water.",
    "Whisk the peanut butter, soy sauce, sesame oil, honey, lime juice and garlic with 2–3 tbsp hot water until smooth.",
